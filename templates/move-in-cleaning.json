{
  "id": "move-in-cleaning",
  "name": "입주청소",
  "version": 4,
  "description": "입주 전 빈집 전체 청소",
  "quoteMode": "fixed",
  "steps": [
    {
      "title": "연락처를 알려주세요",
      "description": "견적이 나오면 이 번호로 안내드립니다.",
      "fields": [
        {
          "key": "name",
          "label": "성함",
          "type": "text",
          "required": true,
          "placeholder": "홍길동",
          "maxLength": 30
        },
        {
          "key": "phone",
          "label": "연락처",
          "type": "tel",
          "required": true,
          "placeholder": "010-0000-0000",
          "maxLength": 20
        }
      ]
    },
    {
      "title": "어디를 청소하나요?",
      "fields": [
        {
          "key": "region",
          "label": "주소 (시/구까지만)",
          "type": "text",
          "required": true,
          "placeholder": "예) 서울 송파구",
          "maxLength": 40
        },
        {
          "key": "buildingType",
          "label": "구조",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "apt",
              "label": "아파트"
            },
            {
              "value": "villa",
              "label": "빌라"
            },
            {
              "value": "officetel",
              "label": "오피스텔"
            },
            {
              "value": "house",
              "label": "주택"
            }
          ]
        }
      ]
    },
    {
      "title": "언제 원하시나요?",
      "fields": [
        {
          "key": "date",
          "label": "희망 날짜",
          "type": "date",
          "required": true
        },
        {
          "key": "timeSlot",
          "label": "시간대",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "first",
              "label": "오전 첫 타임 (8~9시)"
            },
            {
              "value": "am",
              "label": "오전"
            },
            {
              "value": "pm",
              "label": "오후"
            },
            {
              "value": "any",
              "label": "상관없음"
            }
          ]
        }
      ]
    },
    {
      "title": "집 크기를 알려주세요",
      "fields": [
        {
          "key": "area",
          "label": "공급면적 (평)",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 200,
          "placeholder": "예) 34",
          "hint": "분양 평수 기준입니다. ㎡만 아시면 ÷ 3.3 하세요. (84㎡ ≈ 34평)",
          "unit": "평",
          "lookup": "registry"
        },
        {
          "key": "isNew",
          "label": "신축(첫 입주)인가요?",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": true,
              "label": "예, 신축"
            },
            {
              "value": false,
              "label": "아니오"
            }
          ]
        }
      ]
    },
    {
      "title": "방·욕실·베란다·추가 공간 개수",
      "fields": [
        {
          "key": "rooms",
          "label": "방",
          "type": "stepper",
          "required": true,
          "min": 0,
          "max": 10,
          "default": 3
        },
        {
          "key": "baths",
          "label": "욕실",
          "type": "stepper",
          "required": true,
          "min": 0,
          "max": 6,
          "default": 2
        },
        {
          "key": "balconies",
          "label": "베란다",
          "type": "stepper",
          "required": true,
          "min": 0,
          "max": 8,
          "default": 2
        },
        {
          "key": "extraRooms",
          "label": "드레스룸·팬트리·서브주방 등 추가 공간",
          "type": "stepper",
          "required": true,
          "min": 0,
          "max": 6,
          "default": 0
        },
        {
          "key": "hasCloset",
          "label": "붙박이장이 있나요?",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": true,
              "label": "있어요"
            },
            {
              "value": false,
              "label": "없어요"
            }
          ]
        },
        {
          "key": "closets",
          "label": "붙박이장 몇 개인가요?",
          "type": "stepper",
          "required": true,
          "min": 1,
          "max": 10,
          "default": 1,
          "showIf": {
            "field": "hasCloset",
            "equals": true
          },
          "hint": "내부까지 청소할 붙박이장 개수 (한 벽면 = 1개)"
        }
      ]
    },
    {
      "title": "오염 정도는 어떤가요?",
      "description": "이사 후 청소나 거주 중인 집은 오염 정도에 따라 작업량이 달라집니다. 사진을 함께 올리면 더 정확해요.",
      "fields": [
        {
          "key": "contamination",
          "label": "오염 정도",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "normal",
              "label": "보통 (일반적인 생활 먼지·때)"
            },
            {
              "value": "partial",
              "label": "일부 심함 (특정 부분만 심한 오염)"
            },
            {
              "value": "heavy",
              "label": "전체적으로 심함"
            }
          ]
        }
      ]
    },
    {
      "title": "추가요금 체크",
      "description": "현장에서 추가요금 다툼이 없도록 미리 확인합니다. 잘 모르시면 '모름'을 눌러주세요.",
      "fields": [
        {
          "key": "checklist",
          "type": "checklist",
          "required": true
        }
      ]
    },
    {
      "title": "추가로 원하시는 서비스가 있나요?",
      "description": "없으면 그냥 '다음'을 누르세요.",
      "fields": [
        {
          "key": "extras",
          "type": "extras"
        }
      ]
    },
    {
      "title": "사진을 올려주세요",
      "description": "사진이 있으면 현장 추가요금 없이 정확한 견적을 드릴 수 있어요. 아래 위치별로 1장씩 권장합니다.",
      "fields": [
        {
          "key": "photos",
          "type": "photos"
        }
      ]
    },
    {
      "title": "남기실 말씀 (선택)",
      "fields": [
        {
          "key": "memo",
          "label": "요청사항",
          "type": "textarea",
          "placeholder": "예) 비밀번호 현관 출입, 오후 3시 이후 입주 등",
          "maxLength": 500
        }
      ]
    }
  ],
  "checklist": [
    {
      "key": "mold",
      "short": "곰팡이",
      "label": "곰팡이가 있나요?",
      "risk": "yes",
      "optionKey": "mold"
    },
    {
      "key": "sticker",
      "short": "스티커·시트지 자국",
      "label": "스티커·시트지·페인트 자국이 있나요?",
      "risk": "yes",
      "optionKey": "sticker"
    },
    {
      "key": "pet",
      "short": "애완동물",
      "label": "애완동물을 키웠던 집인가요?",
      "risk": "yes",
      "conditionText": "애완동물 털·냄새·배변 흔적이 심한 경우 추가 작업비가 발생할 수 있습니다."
    },
    {
      "key": "grease",
      "short": "심한 기름때",
      "label": "주방에 심한 기름때가 있나요?",
      "risk": "yes",
      "conditionText": "찌든 기름때가 심한 경우 추가 작업비가 발생할 수 있습니다."
    },
    {
      "key": "parking",
      "short": "주차",
      "label": "작업 차량 주차가 가능한가요?",
      "risk": "no",
      "conditionText": "주차가 불가하면 주차비(실비)가 추가될 수 있습니다."
    },
    {
      "key": "elevator",
      "short": "엘리베이터",
      "label": "엘리베이터가 있나요?",
      "risk": "no",
      "conditionText": "엘리베이터가 없으면 장비 운반비가 추가될 수 있습니다."
    }
  ],
  "photoSlots": [
    {
      "key": "window",
      "label": "창틀"
    },
    {
      "key": "bath",
      "label": "욕실"
    },
    {
      "key": "balcony",
      "label": "베란다"
    },
    {
      "key": "kitchen",
      "label": "주방"
    },
    {
      "key": "living",
      "label": "거실"
    },
    {
      "key": "floorplan",
      "label": "도면 (부동산 캡처 등)"
    }
  ],
  "sample": {
    "customer": {
      "name": "테스트 고객",
      "phone": "010-0000-0000",
      "region": "서울 송파구"
    },
    "answers": {
      "buildingType": "apt",
      "timeSlot": "am",
      "area": 34,
      "isNew": true,
      "rooms": 3,
      "baths": 2,
      "balconies": 2,
      "extras": [],
      "memo": "테스트 모드로 만든 샘플 요청입니다.",
      "extraRooms": 1,
      "contamination": "normal",
      "closets": 1,
      "hasCloset": true
    },
    "checklist": {
      "mold": "yes",
      "sticker": "no",
      "pet": "no",
      "grease": "no",
      "parking": "yes",
      "elevator": "yes"
    }
  },
  "pricing": {
    "base": {
      "label": "기본 입주청소",
      "quantityField": "area",
      "unit": "평",
      "unitPriceKey": "unitPrice",
      "unitPriceLabel": "평당 단가",
      "minPriceKey": "minPrice",
      "minPriceLabel": "최소 금액"
    },
    "surcharges": [
      {
        "key": "newBuild",
        "label": "신축",
        "when": {
          "field": "isNew",
          "equals": true
        }
      },
      {
        "key": "weekend",
        "label": "주말·공휴일",
        "when": {
          "any": [
            {
              "field": "$weekend",
              "equals": true
            },
            {
              "field": "$holiday",
              "equals": true
            }
          ]
        }
      },
      {
        "key": "sonEomneun",
        "label": "손 없는 날",
        "when": {
          "field": "$sonEomneun",
          "equals": true
        }
      },
      {
        "key": "firstSlot",
        "label": "오전 첫 타임",
        "when": {
          "field": "timeSlot",
          "equals": "first"
        }
      },
      {
        "key": "contamPartial",
        "label": "오염 일부 심함",
        "when": {
          "field": "contamination",
          "equals": "partial"
        }
      },
      {
        "key": "contamHeavy",
        "label": "오염 전체 심함",
        "when": {
          "field": "contamination",
          "equals": "heavy"
        }
      }
    ],
    "options": [
      {
        "key": "mold",
        "label": "곰팡이 제거"
      },
      {
        "key": "balcony",
        "label": "베란다 추가",
        "unit": "개",
        "quantityField": "balconies",
        "includedQty": 2,
        "priceLabel": "베란다 (2개 초과 1개당)"
      },
      {
        "key": "extraRoom",
        "label": "추가 공간 (드레스룸·팬트리 등)",
        "unit": "개",
        "quantityField": "extraRooms",
        "includedQty": 0,
        "priceLabel": "추가 공간 1개당"
      },
      {
        "key": "closet",
        "label": "붙박이장 내부",
        "unit": "개",
        "quantityField": "closets",
        "includedQty": 0,
        "priceLabel": "붙박이장 1개당"
      },
      {
        "key": "sickHouse",
        "label": "새집증후군 시공",
        "customerSelectable": true
      },
      {
        "key": "window",
        "label": "외창 청소",
        "customerSelectable": true
      },
      {
        "key": "sticker",
        "label": "스티커·페인트 자국 제거"
      }
    ],
    "warnings": [
      {
        "key": "unitPrice",
        "below": 9000,
        "message": "평당 9,000원 미만은 현장 추가금 분쟁이 생기기 쉬운 가격대입니다. (강제 아님)"
      }
    ]
  },
  "defaults": {
    "unitPrice": 12000,
    "minPrice": 250000,
    "surcharges": {
      "newBuild": 20,
      "weekend": 10,
      "sonEomneun": 10,
      "firstSlot": 5,
      "contamPartial": 15,
      "contamHeavy": 30
    },
    "options": {
      "mold": 30000,
      "balcony": 20000,
      "closet": 30000,
      "sickHouse": 150000,
      "window": 50000,
      "sticker": 30000,
      "extraRoom": 30000
    },
    "policy": {
      "validDays": 7,
      "depositPct": 10,
      "cancelPolicy": "작업 3일 전까지 취소 시 계약금 전액 환불, 2일 전~전날 50% 환불, 당일 취소 시 환불 불가."
    }
  },
  "included": [
    "방·거실·주방·욕실 전체 바닥 및 벽면 먼지 제거",
    "창틀·샷시·방충망 청소",
    "주방 싱크대·상부장·하부장 내부",
    "욕실 타일·변기·세면대·수전 물때 제거",
    "베란다 2개까지 기본 포함",
    "현관·신발장 청소"
  ],
  "excluded": [
    "가구·가전 이동 및 내부 청소",
    "외벽·고층 외창 (요청 시 별도)",
    "폐기물 처리"
  ],
  "bookingNotice": ["전기·수도가 들어오는지 미리 확인해주세요.", "엘리베이터 사용 신청(보양)이 필요하면 관리사무소에 미리 말씀해주세요.", "주차 가능 여부와 현관 비밀번호를 알려주세요."],
  "labor": {
    "perField": "area",
    "manHoursPer": 0.27,
    "min": 6,
    "adjust": [
      {
        "when": {
          "field": "isNew",
          "equals": true
        },
        "pct": 20
      },
      {
        "option": "mold",
        "manHours": 2
      },
      {
        "option": "closet",
        "manHours": 1
      }
    ],
    "crew": {
      "min": 2,
      "max": 5,
      "maxHours": 8
    }
  }
}
