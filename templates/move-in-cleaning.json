{
  "id": "move-in-cleaning",
  "name": "입주·이사청소",
  "version": 1,
  "description": "입주 전·이사 나간 뒤 빈집 전체 청소 (신축 입주청소 / 구축 이사청소)",
  "summaryFields": [
    { "key": "area", "unit": "평" },
    { "key": "buildingType" },
    { "key": "baths", "label": "욕실", "unit": "개" }
  ],
  "photoLimit": 20,

  "steps": [
    {
      "title": "연락처를 알려주세요",
      "description": "견적이 나오면 이 번호로 안내드립니다.",
      "fields": [
        { "key": "name", "label": "성함", "type": "text", "required": true, "placeholder": "홍길동", "maxLength": 30 },
        { "key": "phone", "label": "연락처", "type": "tel", "required": true, "placeholder": "010-0000-0000", "maxLength": 20 }
      ]
    },
    {
      "title": "어디를 청소하나요?",
      "fields": [
        { "key": "region", "label": "주소 (시/구까지만)", "type": "text", "required": true, "placeholder": "예) 서울 송파구", "maxLength": 40 },
        { "key": "buildingType", "label": "구조", "type": "choice", "required": true,
          "options": [
            { "value": "apt", "label": "아파트" },
            { "value": "villa", "label": "빌라" },
            { "value": "officetel", "label": "오피스텔" },
            { "value": "house", "label": "주택" }
          ] }
      ]
    },
    {
      "title": "언제 원하시나요?",
      "fields": [
        { "key": "date", "label": "희망 날짜", "type": "date", "required": true },
        { "key": "timeSlot", "label": "시간대", "type": "choice", "required": true,
          "options": [
            { "value": "first", "label": "오전 첫 타임 (8~9시)" },
            { "value": "am", "label": "오전" },
            { "value": "pm", "label": "오후" },
            { "value": "any", "label": "상관없음" }
          ] }
      ]
    },
    {
      "title": "집 크기를 알려주세요",
      "fields": [
        { "key": "area", "label": "공급면적 (평)", "type": "number", "required": true, "min": 1, "max": 200,
          "placeholder": "예) 34",
          "hint": "관리비 고지서·분양계약서의 '공급면적(㎡)' ÷ 3.3 입니다. 전용면적이 아닙니다. 참고: 아파트 전용 59㎡ ≈ 공급 24~25평, 전용 84㎡ ≈ 공급 32~35평." },
        { "key": "isNew", "label": "신축(첫 입주)인가요?", "type": "choice", "required": true,
          "options": [
            { "value": true, "label": "예, 신축" },
            { "value": false, "label": "아니오" }
          ] }
      ]
    },
    {
      "title": "방·욕실·베란다 개수",
      "fields": [
        { "key": "rooms", "label": "방", "type": "stepper", "required": true, "min": 0, "max": 10, "default": 3 },
        { "key": "baths", "label": "욕실", "type": "stepper", "required": true, "min": 0, "max": 6, "default": 2 },
        { "key": "balconies", "label": "베란다", "type": "stepper", "required": true, "min": 0, "max": 8, "default": 2 }
      ]
    },
    {
      "title": "추가요금 체크",
      "description": "현장에서 추가요금 다툼이 없도록 미리 확인합니다. 잘 모르시면 '모름'을 눌러주세요.",
      "fields": [ { "key": "checklist", "type": "checklist", "required": true } ]
    },
    {
      "title": "추가로 원하시는 서비스가 있나요?",
      "description": "없으면 그냥 '다음'을 누르세요.",
      "fields": [ { "key": "extras", "type": "extras" } ]
    },
    {
      "title": "사진을 올려주세요",
      "description": "칸을 누르면 찍는 방법이 나와요. 같은 곳도 멀리 한 장, 가까이 한 장이면 현장 추가요금이 줄어요.",
      "fields": [ { "key": "photos", "type": "photos" } ]
    },
    {
      "title": "남기실 말씀 (선택)",
      "fields": [
        { "key": "memo", "label": "요청사항", "type": "textarea", "placeholder": "예) 오후 3시 이후 입주, 주차 공간 없음", "maxLength": 500 }
      ]
    }
  ],

  "checklist": [
    { "key": "areaChecked", "short": "면적 확인", "label": "입력하신 평수를 관리비 고지서·분양계약서의 '공급면적'으로 확인하셨나요?", "risk": "no",
      "conditionText": "현장에서 공급면적이 입력값과 다르면 '실제 공급면적 × 평당 단가'로 다시 계산하고, 작업 전에 금액을 알려드립니다. (다른 금액 변경 없음)" },
    { "key": "leftover", "short": "남은 가구·짐", "label": "청소 당일 집 안에 가구·짐이 남아 있나요?", "risk": "yes",
      "conditionText": "남아 있는 가구·짐은 옮기지 않으며, 그 자리와 가구 뒤·아래는 청소 범위에서 제외됩니다. 금액은 변하지 않습니다." },
    { "key": "mold", "short": "곰팡이", "label": "욕실·베란다·창틀 실리콘에 검은 곰팡이가 있나요?", "risk": "yes", "optionKey": "mold" },
    { "key": "closet", "short": "붙박이장", "label": "붙박이장 내부 청소가 필요한가요?", "risk": "yes", "optionKey": "closet" },
    { "key": "sticker", "short": "스티커·시트지 자국", "label": "스티커·시트지·페인트 자국이 있나요?", "risk": "yes", "optionKey": "sticker" },
    { "key": "pet", "short": "애완동물 흔적", "label": "애완동물을 키웠던 집인가요? (털·냄새·배변 흔적)", "risk": "yes", "optionKey": "pet" },
    { "key": "grease", "short": "주방 찌든 기름때", "label": "가스레인지 주변 벽·후드에 손으로 닦아도 안 지워지는 끈적한 기름때가 있나요?", "risk": "yes", "optionKey": "grease" },
    { "key": "nicotine", "short": "담배 찌든 때", "label": "벽지·천장이 담배 때문에 누렇게 변했나요?", "risk": "yes", "optionKey": "nicotine" },
    { "key": "parking", "short": "주차", "label": "작업 차량 주차가 가능한가요?", "risk": "no",
      "conditionText": "건물 안에 작업 차량을 댈 수 없으면 근처 유료주차장 주차비가 영수증 실비로 추가됩니다. 작업 전에 예상 금액을 알려드립니다." },
    { "key": "elevator", "short": "엘리베이터", "label": "엘리베이터가 있나요? (1층·주택 1층이면 '예')", "risk": "no", "optionKey": "noElevator" }
  ],

  "photoSlots": [
    { "key": "living", "label": "거실",
      "shots": [
        { "key": "wide", "label": "전체", "required": true, "illustration": "room-wide", "tip": "현관 쪽에 서서 거실 전체가 나오게 찍어 주세요" }
      ] },
    { "key": "kitchen", "label": "주방",
      "shots": [
        { "key": "wide", "label": "전체", "required": true, "illustration": "room-wide", "tip": "싱크대와 가스레인지가 한 화면에 나오게 찍어 주세요" },
        { "key": "close", "label": "가까이", "required": false, "illustration": "closeup", "tip": "후드·가스레인지 기름때를 30cm 앞에서 찍어 주세요" }
      ] },
    { "key": "bath", "label": "욕실", "repeatField": "baths",
      "shots": [
        { "key": "wide", "label": "전체", "required": true, "illustration": "room-wide", "tip": "문 앞에 서서 바닥부터 천장까지 나오게 찍어 주세요" },
        { "key": "close", "label": "가까이", "required": false, "illustration": "closeup", "tip": "곰팡이·물때가 있으면 30cm 앞에서 찍어 주세요" }
      ] },
    { "key": "balcony", "label": "베란다", "repeatField": "balconies",
      "shots": [
        { "key": "wide", "label": "전체", "required": true, "illustration": "room-wide", "tip": "베란다 문 앞에서 바닥과 창이 다 나오게 찍어 주세요" },
        { "key": "close", "label": "가까이", "required": false, "illustration": "closeup", "tip": "곰팡이·결로 자국이 있으면 30cm 앞에서 찍어 주세요" }
      ] },
    { "key": "window", "label": "창틀",
      "shots": [
        { "key": "close", "label": "가까이", "required": true, "illustration": "closeup", "tip": "먼지가 가장 많은 창틀 아래쪽을 30cm 앞에서 찍어 주세요" }
      ] }
  ],

  "pricing": {
    "base": {
      "label": "기본 입주청소",
      "quantityField": "area",
      "unit": "평",
      "unitPriceKey": "unitPrice",
      "unitPriceLabel": "평당 단가",
      "minPriceKey": "minPrice",
      "minPriceLabel": "최소 금액"
    },
    "surcharges": [
      { "key": "newBuild", "label": "신축", "when": { "field": "isNew", "equals": true } },
      { "key": "weekend", "label": "주말·공휴일",
        "when": { "any": [ { "field": "$weekend", "equals": true }, { "field": "$holiday", "equals": true } ] } },
      { "key": "sonEomneun", "label": "손 없는 날", "when": { "field": "$sonEomneun", "equals": true } },
      { "key": "firstSlot", "label": "오전 첫 타임", "when": { "field": "timeSlot", "equals": "first" } }
    ],
    "options": [
      { "key": "mold", "label": "곰팡이 제거" },
      { "key": "balcony", "label": "베란다 추가", "unit": "개", "quantityField": "balconies", "includedQty": 2,
        "priceLabel": "베란다 (2개 초과 1개당)" },
      { "key": "closet", "label": "붙박이장 내부" },
      { "key": "sickHouse", "label": "새집증후군 시공", "customerSelectable": true },
      { "key": "window", "label": "외창 청소", "customerSelectable": true },
      { "key": "sticker", "label": "스티커·페인트 자국 제거" },
      { "key": "pet", "label": "애완동물 털·냄새·배변 흔적 제거" },
      { "key": "grease", "label": "주방 찌든 기름때 집중 제거" },
      { "key": "nicotine", "label": "담배 찌든 때(니코틴) 제거" },
      { "key": "noElevator", "label": "계단 장비 운반 (엘리베이터 없는 경우)", "listInExcluded": false }
    ],
    "warnings": [
      { "key": "unitPrice", "below": 9000,
        "message": "평당 9,000원 미만은 현장 추가금 분쟁이 생기기 쉬운 가격대입니다. (강제 아님)" }
    ]
  },

  "defaults": {
    "unitPrice": 12000,
    "minPrice": 250000,
    "surcharges": { "newBuild": 20, "weekend": 10, "sonEomneun": 10, "firstSlot": 5 },
    "options": { "mold": 30000, "balcony": 20000, "closet": 30000, "sickHouse": 150000, "window": 50000, "sticker": 30000,
                 "pet": 30000, "grease": 30000, "nicotine": 50000, "noElevator": 30000 },
    "policy": {
      "validDays": 7,
      "depositPct": 10,
      "cancelPolicy": "■ 7일 안 취소: 계약 확정 안내(온라인 결제는 계약금 결제 완료 안내)를 받은 날부터 7일 이내이고 작업 시작 전이면, 언제 취소하셔도 계약금 전액을 돌려드립니다.\n■ 7일이 지난 뒤 고객님 사정으로 취소하실 때 (작업일 기준)\n · 3일 전 자정까지: 계약금 전액 환불\n · 2일 전 0시부터 전날 자정까지: 계약금의 50%를 공제하고 나머지 환불\n · 작업 당일 취소, 또는 방문했으나 고객님 사정으로 작업하지 못한 경우: 계약금 전액 공제 (잔금은 청구하지 않습니다)\n■ 업체 사정으로 취소할 때: 계약금 전액을 돌려드리고, 계약금과 같은 금액을 추가로 배상합니다.\n■ 천재지변 등 누구의 잘못도 아닌 사유로 작업할 수 없게 되면 날짜를 다시 잡아 드리고, 원하시면 계약금 전액을 돌려드립니다.\n■ 환불은 취소 요청을 받은 날부터 3영업일 안에 결제하신 수단(계좌로 입금하셨다면 그 계좌)으로 해드립니다.\n■ 관련 법령이 이 규정보다 고객님께 유리하면 법령을 따릅니다."
    }
  },

  "included": [
    "방·거실·주방·욕실 전체 바닥 및 벽면 먼지 제거",
    "창틀·샷시·방충망 청소",
    "주방 싱크대·상부장·하부장 내부",
    "욕실 타일·변기·세면대·수전 물때 제거",
    "베란다 2개까지 기본 포함",
    "현관·신발장 청소"
  ],
  "excluded": [
    "가구·가전 이동 및 내부 청소 (남아 있는 가구·짐의 자리와 뒤·아래 포함)",
    "외벽·고층 외창 (요청 시 별도)",
    "폐기물 처리"
  ]
}
