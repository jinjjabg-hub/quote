{
  "id": "home-cleaning",
  "name": "거주청소",
  "version": 1,
  "description": "살고 있는 집(짐·가구 있음) 전체 청소. 가구 이동·짐 정리는 하지 않습니다.",

  "steps": [
    {
      "title": "연락처를 알려주세요",
      "description": "견적이 나오면 이 번호로 안내드립니다.",
      "fields": [
        { "key": "name", "label": "성함", "type": "text", "required": true, "placeholder": "홍길동", "maxLength": 30 },
        { "key": "phone", "label": "연락처", "type": "tel", "required": true, "placeholder": "010-0000-0000", "maxLength": 20 }
      ]
    },
    {
      "title": "어디를 청소하나요?",
      "fields": [
        { "key": "region", "label": "주소 (시/구까지만)", "type": "text", "required": true, "placeholder": "예) 서울 송파구", "maxLength": 40 },
        { "key": "buildingType", "label": "구조", "type": "choice", "required": true,
          "options": [
            { "value": "apt", "label": "아파트" },
            { "value": "villa", "label": "빌라" },
            { "value": "officetel", "label": "오피스텔" },
            { "value": "house", "label": "주택" }
          ] }
      ]
    },
    {
      "title": "언제 원하시나요?",
      "fields": [
        { "key": "date", "label": "희망 날짜", "type": "date", "required": true },
        { "key": "timeSlot", "label": "시간대", "type": "choice", "required": true,
          "options": [
            { "value": "first", "label": "오전 첫 타임 (8~9시)" },
            { "value": "am", "label": "오전" },
            { "value": "pm", "label": "오후" },
            { "value": "any", "label": "상관없음" }
          ] }
      ]
    },
    {
      "title": "집 크기를 알려주세요",
      "fields": [
        { "key": "area", "label": "공급면적 (평)", "type": "number", "required": true, "min": 1, "max": 200,
          "placeholder": "예) 33",
          "hint": "관리비 고지서·분양계약서의 '공급면적(㎡)' ÷ 3.3 입니다. 전용면적이 아닙니다. 참고: 아파트 전용 59㎡ ≈ 공급 24~25평, 전용 84㎡ ≈ 공급 32~35평." }
      ]
    },
    {
      "title": "방·욕실·베란다 개수",
      "description": "베란다는 확장하지 않아 따로 남아 있는 공간만 세어 주세요.",
      "fields": [
        { "key": "rooms", "label": "방", "type": "stepper", "required": true, "min": 0, "max": 10, "default": 3 },
        { "key": "baths", "label": "욕실", "type": "stepper", "required": true, "min": 0, "max": 6, "default": 2 },
        { "key": "balconies", "label": "베란다 (비확장)", "type": "stepper", "required": true, "min": 0, "max": 8, "default": 1 }
      ]
    },
    {
      "title": "함께 사는 환경",
      "description": "청소 시간이 달라지는 항목이라 미리 여쭙니다.",
      "fields": [
        { "key": "pet", "label": "지금 집 안에서 반려동물(개·고양이)을 키우시나요?", "type": "choice", "required": true,
          "options": [
            { "value": "yes", "label": "예" },
            { "value": "no", "label": "아니오" }
          ] },
        { "key": "smoking", "label": "집 안(베란다·화장실 포함)에서 담배를 피우시나요?", "type": "choice", "required": true,
          "options": [
            { "value": "yes", "label": "예" },
            { "value": "no", "label": "아니오" }
          ] }
      ]
    },
    {
      "title": "추가요금 체크",
      "description": "현장에서 추가요금 다툼이 없도록 미리 확인합니다. 잘 모르시면 '모름'을 눌러주세요.",
      "fields": [ { "key": "checklist", "type": "checklist", "required": true } ]
    },
    {
      "title": "추가로 원하시는 서비스가 있나요?",
      "description": "없으면 그냥 '다음'을 누르세요.",
      "fields": [ { "key": "extras", "type": "extras" } ]
    },
    {
      "title": "사진을 올려주세요",
      "description": "짐이 있는 그대로 찍어 주세요. 사진이 있으면 현장 추가요금 없이 정확한 견적을 드릴 수 있어요.",
      "fields": [ { "key": "photos", "type": "photos" } ]
    },
    {
      "title": "남기실 말씀 (선택)",
      "fields": [
        { "key": "memo", "label": "요청사항", "type": "textarea", "placeholder": "예) 아이 방은 제외, 오후 2시 이후 가능 등", "maxLength": 500 }
      ]
    }
  ],

  "checklist": [
    { "key": "areaChecked", "short": "면적 확인", "label": "입력하신 평수를 관리비 고지서·분양계약서의 '공급면적'으로 확인하셨나요?", "risk": "no",
      "conditionText": "현장에서 공급면적이 입력값과 다르면 '실제 공급면적 × 평당 단가'로 다시 계산합니다. (다른 금액 변경 없음)" },
    { "key": "mold", "short": "곰팡이", "label": "욕실·베란다·창틀 실리콘에 검은 곰팡이가 있나요?", "risk": "yes", "optionKey": "mold" },
    { "key": "grease", "short": "주방 찌든 기름때", "label": "가스레인지 주변 벽·후드에 손으로 닦아도 안 지워지는 끈적한 기름때가 있나요?", "risk": "yes", "optionKey": "grease" },
    { "key": "clutter", "short": "바닥 짐", "label": "바닥에 박스·짐이 쌓여 있어 치워야 청소할 수 있는 곳이 있나요?", "risk": "yes",
      "conditionText": "짐 정리·이동은 포함되지 않습니다. 작업 당일 바닥에 짐이 놓인 자리와 가구 뒤·아래는 청소 범위에서 제외되며, 금액은 변하지 않습니다." },
    { "key": "elevator", "short": "엘리베이터", "label": "엘리베이터가 있나요? (1층·주택 1층이면 '예')", "risk": "no", "optionKey": "noElevator" },
    { "key": "parking", "short": "주차", "label": "작업 차량(승합차) 주차가 가능한가요?", "risk": "no",
      "conditionText": "건물 내 주차가 불가하면 인근 유료주차장 주차비(영수증 실비)가 추가됩니다." }
  ],

  "photoSlots": [
    { "key": "living", "label": "거실 전체 (현관 쪽에서)" },
    { "key": "room", "label": "짐이 가장 많은 방" },
    { "key": "kitchen", "label": "주방 가스레인지·후드" },
    { "key": "bath", "label": "욕실 (변기·실리콘이 보이게)" },
    { "key": "balcony", "label": "베란다 (비확장)" },
    { "key": "window", "label": "창틀·샷시 하단" }
  ],

  "pricing": {
    "base": {
      "label": "기본 거주청소",
      "quantityField": "area",
      "unit": "평",
      "unitPriceKey": "unitPrice",
      "unitPriceLabel": "평당 단가 (공급면적)",
      "minPriceKey": "minPrice",
      "minPriceLabel": "최소 금액"
    },
    "surcharges": [
      { "key": "weekend", "label": "주말·공휴일",
        "when": { "any": [ { "field": "$weekend", "equals": true }, { "field": "$holiday", "equals": true } ] } },
      { "key": "firstSlot", "label": "오전 첫 타임", "when": { "field": "timeSlot", "equals": "first" } },
      { "key": "pet", "label": "반려동물 거주", "when": { "field": "pet", "equals": "yes" } },
      { "key": "smoking", "label": "실내 흡연", "when": { "field": "smoking", "equals": "yes" } }
    ],
    "options": [
      { "key": "mold", "label": "곰팡이 제거" },
      { "key": "grease", "label": "주방 찌든 기름때 집중 제거" },
      { "key": "balcony", "label": "베란다 추가", "unit": "개", "quantityField": "balconies", "includedQty": 1,
        "priceLabel": "비확장 베란다 (1개 초과 1개당)" },
      { "key": "bath", "label": "욕실 추가", "unit": "개", "quantityField": "baths", "includedQty": 2,
        "priceLabel": "욕실 (2개 초과 1개당)" },
      { "key": "noElevator", "label": "계단 장비 운반 (엘리베이터 없는 경우)" },
      { "key": "fridge", "label": "냉장고 내부 (비워 두신 경우)", "customerSelectable": true },
      { "key": "closet", "label": "붙박이장 내부 (비워 두신 경우)", "customerSelectable": true },
      { "key": "hood", "label": "주방 후드 필터 분리 세척", "customerSelectable": true },
      { "key": "window", "label": "외창 청소", "customerSelectable": true }
    ],
    "warnings": [
      { "key": "unitPrice", "below": 13000,
        "message": "거주청소는 짐이 있어 입주청소보다 시간이 더 듭니다. 평당 13,000원 미만은 현장 추가금 분쟁이 생기기 쉬운 가격대입니다. (강제 아님)" }
    ]
  },

  "defaults": {
    "unitPrice": 15000,
    "minPrice": 300000,
    "surcharges": { "weekend": 10, "firstSlot": 5, "pet": 10, "smoking": 20 },
    "options": { "mold": 40000, "grease": 30000, "balcony": 20000, "bath": 30000, "noElevator": 30000,
                 "fridge": 30000, "closet": 30000, "hood": 20000, "window": 60000 },
    "policy": {
      "validDays": 7,
      "depositPct": 10,
      "cancelPolicy": "작업 3일 전까지 취소 시 계약금 전액 환불, 2일 전~전날 50% 환불, 당일 취소 시 환불 불가."
    }
  },

  "included": [
    "방·거실·주방·욕실의 노출된 바닥·벽면·문·몰딩 먼지 제거 (가구 이동 없음)",
    "창틀·샷시·방충망 (안쪽)",
    "주방 싱크대·가스레인지·상판, 상부장·하부장 외부",
    "욕실 타일·변기·세면대·욕조·수전 물때 제거",
    "비확장 베란다 1개까지 기본 포함",
    "현관·신발장 외부"
  ],
  "excluded": [
    "가구·가전 이동, 짐 정리·정돈",
    "짐이 놓인 바닥, 가구 뒤·아래",
    "수납장·서랍·가전 내부 (옵션 선택 시 제외)",
    "외벽·고층 외창 (요청 시 별도)",
    "폐기물·생활쓰레기 처리"
  ]
}
