{
  "id": "aircon-install",
  "name": "에어컨 설치",
  "version": 1,
  "description": "가정용 벽걸이·스탠드·2in1 신규 설치 및 이전 설치 (시스템·천장형 제외)",

  "steps": [
    {
      "title": "연락처를 알려주세요",
      "description": "견적이 나오면 이 번호로 안내드립니다.",
      "fields": [
        { "key": "name", "label": "성함", "type": "text", "required": true, "placeholder": "홍길동", "maxLength": 30 },
        { "key": "phone", "label": "연락처", "type": "tel", "required": true, "placeholder": "010-0000-0000", "maxLength": 20 }
      ]
    },
    {
      "title": "어디에 설치하나요?",
      "fields": [
        { "key": "region", "label": "설치할 주소 (시/구까지만)", "type": "text", "required": true, "placeholder": "예) 서울 송파구", "maxLength": 40 },
        { "key": "buildingType", "label": "구조", "type": "choice", "required": true,
          "options": [
            { "value": "apt", "label": "아파트" },
            { "value": "villa", "label": "빌라" },
            { "value": "officetel", "label": "오피스텔" },
            { "value": "house", "label": "주택" },
            { "value": "store", "label": "상가·사무실" }
          ] },
        { "key": "floor", "label": "설치 층", "type": "number", "required": true, "min": -5, "max": 80, "placeholder": "예) 12",
          "hint": "실외기를 둘 층 기준입니다. 지하는 -1처럼 적어주세요." }
      ]
    },
    {
      "title": "언제 원하시나요?",
      "fields": [
        { "key": "date", "label": "희망 날짜", "type": "date", "required": true },
        { "key": "timeSlot", "label": "시간대", "type": "choice", "required": true,
          "options": [
            { "value": "am", "label": "오전" },
            { "value": "pm", "label": "오후" },
            { "value": "any", "label": "상관없음" }
          ] }
      ]
    },
    {
      "title": "어떤 작업인가요?",
      "fields": [
        { "key": "workType", "label": "작업 종류", "type": "choice", "required": true,
          "options": [
            { "value": "new", "label": "새 제품 설치" },
            { "value": "move", "label": "쓰던 에어컨 옮겨 설치 (이전 설치)" }
          ] },
        { "key": "units", "label": "설치할 실내기 대수 (전체)", "type": "stepper", "required": true, "min": 1, "max": 6, "default": 1 },
        { "key": "standUnits", "label": "그중 스탠드형 대수", "type": "stepper", "required": true, "min": 0, "max": 6, "default": 0 },
        { "key": "removeUnits", "label": "기존 자리에서 떼어낼 대수", "type": "stepper", "required": true, "min": 0, "max": 6, "default": 0 },
        { "key": "model", "label": "제품 모델명", "type": "text", "placeholder": "예) AF17B6474TZS", "maxLength": 40,
          "hint": "2in1(스탠드+벽걸이)은 전체 2대, 스탠드 1대로 입력하세요. 이전 설치면 '떼어낼 대수'도 같은 수로 입력하세요." }
      ]
    },
    {
      "title": "배관 길이를 골라주세요",
      "description": "실내기에서 실외기까지 벽을 따라 잰 거리입니다. 정확하지 않아도 괜찮아요. 설치 당일 줄자로 재서, 고른 것보다 길면 초과분만 추가되고 짧으면 빼드립니다.",
      "fields": [
        { "key": "pipeLength", "label": "실내기 1대 기준 예상 배관 길이", "type": "choice", "required": true,
          "options": [
            { "value": 3, "label": "실외기가 벽 바로 뒤 (약 3m)" },
            { "value": 5, "label": "같은 방 창가 → 바로 밖 실외기 (약 5m)" },
            { "value": 7, "label": "방 하나를 지나 베란다·실외기실 (약 7m)" },
            { "value": 10, "label": "거실 끝 → 반대편 실외기실 (약 10m)" },
            { "value": 15, "label": "그보다 멀다 (약 15m)" }
          ],
          "hint": "2대 이상이면 가장 먼 실내기 기준으로 골라주세요. 나머지 실내기의 초과 배관은 실측 후 같은 m당 단가로 정산합니다." }
      ]
    },
    {
      "title": "추가요금 체크",
      "description": "현장에서 추가요금 다툼이 없도록 미리 확인합니다. 잘 모르시면 '모름'을 눌러주세요.",
      "fields": [ { "key": "checklist", "type": "checklist", "required": true } ]
    },
    {
      "title": "추가로 원하시는 서비스가 있나요?",
      "description": "없으면 그냥 '다음'을 누르세요.",
      "fields": [ { "key": "extras", "type": "extras" } ]
    },
    {
      "title": "사진을 올려주세요",
      "description": "사진이 있으면 배관 길이·실외기 위치를 미리 보고 현장 추가요금 없이 정확한 견적을 드릴 수 있어요.",
      "fields": [ { "key": "photos", "type": "photos" } ]
    },
    {
      "title": "남기실 말씀 (선택)",
      "fields": [
        { "key": "memo", "label": "요청사항", "type": "textarea", "placeholder": "예) 이전 설치 출발지 주소, 관리사무소 작업 허가 필요 여부 등", "maxLength": 500 }
      ]
    }
  ],

  "checklist": [
    { "key": "angle", "short": "실외기 앵글", "label": "실외기를 바닥(실외기실·베란다 안·1층 땅)이 아니라 난간이나 창밖 벽에 달아야 하나요?", "risk": "yes", "optionKey": "angle" },
    { "key": "highWork", "short": "고층 외벽 작업", "label": "실외기 놓을 곳이 창밖(외벽·난간 바깥)이면서 3층 이상인가요?", "risk": "yes", "optionKey": "highWork" },
    { "key": "hardWall", "short": "콘크리트·대리석 타공", "label": "배관 구멍을 새로 뚫을 벽이 콘크리트 외벽·대리석·두꺼운 타일인가요?", "risk": "yes", "optionKey": "coreHard" },
    { "key": "embedded", "short": "매립배관", "label": "벽 속에 미리 묻힌 배관(매립배관)을 사용하나요?", "risk": "yes", "optionKey": "embeddedFlush" },
    { "key": "gas", "short": "냉매 보충", "label": "(이전 설치만) 떼어낸 지 1개월 이상 됐거나, 전에 냉방이 약했나요?", "risk": "yes", "optionKey": "gasCharge" },
    { "key": "drain", "short": "배수", "label": "실내기 물(응축수)을 밖이나 배수구로 자연스럽게 뺄 수 있나요?", "risk": "no", "optionKey": "drainPump" },
    { "key": "power", "short": "전원", "label": "실내기 설치 자리 근처(1.5m 안)에 콘센트가 있나요?", "risk": "no",
      "conditionText": "콘센트가 멀거나 전용 회로가 필요하면 전기선 연장·전용선 공사비가 추가됩니다. (작업 전 금액 고지 후 동의 시 진행)" },
    { "key": "permit", "short": "관리사무소 허가", "label": "외벽 작업·타공에 관리사무소 허가가 필요한 건물인가요?", "risk": "yes",
      "conditionText": "관리사무소 허가가 없으면 당일 외벽 작업·타공이 불가할 수 있습니다. 허가는 고객님이 미리 받아주세요. 허가 문제로 작업이 불가하면 출장비가 청구될 수 있습니다." }
  ],

  "photoSlots": [
    { "key": "indoorSpot", "label": "실내기 놓을 자리 (벽 전체)" },
    { "key": "path", "label": "실내기→실외기 가는 길 (방·거실 전체)" },
    { "key": "outdoorSpot", "label": "실외기 놓을 자리 (실외기실·베란다·창밖)" },
    { "key": "outsideView", "label": "창밖으로 내려다본 외벽·난간" },
    { "key": "hole", "label": "기존 배관 구멍·매립배관 마감 캡" },
    { "key": "label", "label": "제품 모델명 스티커 (이전 설치 시 실외기 옆면)" }
  ],

  "pricing": {
    "base": {
      "label": "기본 설치 (벽걸이 기준)",
      "quantityField": "units",
      "unit": "대",
      "unitPriceKey": "unitPrice",
      "unitPriceLabel": "대당 기본 설치비 (벽걸이 기준, 배관 5m 포함)",
      "minPriceKey": "minPrice",
      "minPriceLabel": "최소 출장 금액"
    },
    "surcharges": [
      { "key": "weekend", "label": "주말·공휴일",
        "when": { "any": [ { "field": "$weekend", "equals": true }, { "field": "$holiday", "equals": true } ] } }
    ],
    "options": [
      { "key": "standUnit", "label": "스탠드형 추가 공임", "unit": "대", "quantityField": "standUnits", "includedQty": 0,
        "priceLabel": "스탠드형 (벽걸이 대비 대당 추가)" },
      { "key": "pipeExtra", "label": "배관 추가 (기본 5m 초과)", "unit": "m", "quantityField": "pipeLength", "includedQty": 5,
        "priceLabel": "배관 추가 1m당 (동관·보온재·전선·배수호스 포함)" },
      { "key": "removal", "label": "기존 자리 철거·배관 회수", "unit": "대", "quantityField": "removeUnits", "includedQty": 0,
        "priceLabel": "철거 (대당)" },
      { "key": "angle", "label": "실외기 앵글(거치대) 설치" },
      { "key": "highWork", "label": "고층 외벽 위험작업 (로프·안전장비)" },
      { "key": "coreHard", "label": "콘크리트·대리석 타공" },
      { "key": "extraHole", "label": "추가 타공 (1회)" },
      { "key": "embeddedFlush", "label": "매립배관 세척·기밀 점검" },
      { "key": "gasCharge", "label": "냉매(가스) 보충" },
      { "key": "drainPump", "label": "배수 펌프 설치" },
      { "key": "weld", "label": "배관 용접 (연장 접합)" },
      { "key": "disposal", "label": "기존 에어컨 폐기·수거", "customerSelectable": true }
    ],
    "warnings": [
      { "key": "unitPrice", "below": 100000,
        "message": "대당 기본 설치비 10만원 미만은 현장에서 배관·앵글 추가금이 커져 분쟁이 생기기 쉬운 가격대입니다. (강제 아님)" }
    ]
  },

  "defaults": {
    "unitPrice": 150000,
    "minPrice": 150000,
    "surcharges": { "weekend": 0 },
    "options": {
      "standUnit": 50000,
      "pipeExtra": 20000,
      "removal": 50000,
      "angle": 130000,
      "highWork": 100000,
      "coreHard": 30000,
      "extraHole": 10000,
      "embeddedFlush": 50000,
      "gasCharge": 80000,
      "drainPump": 100000,
      "weld": 30000,
      "disposal": 30000
    },
    "policy": {
      "validDays": 7,
      "depositPct": 10,
      "cancelPolicy": "작업 2일 전까지 취소 시 계약금 전액 환불, 전날 50% 환불, 당일 취소 시 환불 불가. 관리사무소 허가·전원 미비 등 고객 사정으로 당일 작업이 불가하면 출장비가 청구될 수 있습니다."
    }
  },

  "included": [
    "실내기·실외기 설치 및 시운전 (냉방 확인)",
    "배관 5m (동관·보온재·전선·배수호스) — 초과분은 견적서 '배관 추가' m당 단가로만 계산",
    "설치 당일 줄자 실측: 견적보다 길면 초과 m만 추가, 짧으면 m당 단가로 차감",
    "진공 작업 (진공 펌프로 배관 속 공기·수분 제거) — 별도 청구 없음",
    "일반 벽(석고·벽돌) 타공 1회 또는 기존 구멍 사용",
    "실외기 바닥 거치 (실외기실·베란다 안·1층 땅)",
    "설치 후 배관 마감 테이핑·구멍 실리콘 마감"
  ],
  "excluded": [
    "사다리차·스카이차 (필요 시 작업 전 실비 고지·동의 후 진행)",
    "매립배관 불량(누설·막힘) 시 교체·노출 배관 전환 — 점검 결과 사진으로 보여드리고 동의 후 m당 단가로 진행",
    "전기 전용선·차단기 공사",
    "시스템·천장형 에어컨 (별도 현장 견적)",
    "제품 자체 고장·부품 (이전 설치 시 기존 고장 포함)"
  ]
}
