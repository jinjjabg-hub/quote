{
  "id": "aircon-cleaning",
  "name": "에어컨 청소",
  "version": 1,
  "status": "draft",
  "draftNote": "⚠️ 업계 일반 기준으로 만든 예시 초안입니다. 실제 사장님 단가·질문으로 검증 후 사용하세요.",
  "description": "벽걸이·스탠드·시스템 에어컨 분해 세척",
  "quoteMode": "fixed",
  "steps": [
    {
      "title": "연락처를 알려주세요",
      "description": "견적이 나오면 이 번호로 안내드립니다.",
      "fields": [
        {
          "key": "name",
          "label": "성함",
          "type": "text",
          "required": true,
          "placeholder": "홍길동",
          "maxLength": 30
        },
        {
          "key": "phone",
          "label": "연락처",
          "type": "tel",
          "required": true,
          "placeholder": "010-0000-0000",
          "maxLength": 20
        }
      ]
    },
    {
      "title": "어디인가요?",
      "fields": [
        {
          "key": "region",
          "label": "주소 (시/구까지만)",
          "type": "text",
          "required": true,
          "placeholder": "예) 부산 부산진구",
          "maxLength": 40
        },
        {
          "key": "buildingType",
          "label": "건물",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "home",
              "label": "가정"
            },
            {
              "value": "shop",
              "label": "매장·사무실"
            }
          ]
        }
      ]
    },
    {
      "title": "언제 원하시나요?",
      "fields": [
        {
          "key": "date",
          "label": "희망 날짜",
          "type": "date",
          "required": true
        },
        {
          "key": "timeSlot",
          "label": "시간대",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "am",
              "label": "오전"
            },
            {
              "value": "pm",
              "label": "오후"
            },
            {
              "value": "any",
              "label": "상관없음"
            }
          ]
        }
      ]
    },
    {
      "title": "어떤 에어컨이 몇 대인가요?",
      "description": "종류별로 대수를 넣어주세요.",
      "fields": [
        {
          "key": "units",
          "label": "에어컨",
          "type": "items",
          "required": true,
          "itemTypes": "pricing"
        }
      ]
    },
    {
      "title": "세척 방식",
      "fields": [
        {
          "key": "washLevel",
          "label": "세척 방식",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "normal",
              "label": "일반 분해 세척"
            },
            {
              "value": "full",
              "label": "완전 분해 세척 (+)"
            }
          ]
        }
      ]
    },
    {
      "title": "추가요금 체크",
      "description": "현장에서 추가요금 다툼이 없도록 미리 확인합니다. 잘 모르시면 '모름'을 눌러주세요.",
      "fields": [
        {
          "key": "checklist",
          "type": "checklist",
          "required": true
        }
      ]
    },
    {
      "title": "추가로 원하시는 서비스가 있나요?",
      "description": "없으면 그냥 '다음'을 누르세요.",
      "fields": [
        {
          "key": "extras",
          "type": "extras"
        }
      ]
    },
    {
      "title": "사진을 올려주세요",
      "description": "에어컨마다 앞모습 1장, 모델명 스티커 1장을 권장합니다. 실외기 위치도 1장 찍어주세요.",
      "fields": [
        {
          "key": "photos",
          "type": "photos"
        }
      ]
    },
    {
      "title": "남기실 말씀 (선택)",
      "fields": [
        {
          "key": "memo",
          "label": "요청사항",
          "type": "textarea",
          "maxLength": 500
        }
      ]
    }
  ],
  "checklist": [
    {
      "key": "height",
      "short": "설치 높이",
      "label": "사다리가 필요한 높이(2.5m 이상)에 있나요?",
      "risk": "yes",
      "conditionText": "고소 작업 시 사다리 작업비가 추가될 수 있습니다."
    },
    {
      "key": "outdoorRisk",
      "short": "실외기 위치",
      "label": "실외기가 난간 밖 등 위험한 곳에 있나요?",
      "risk": "yes",
      "optionKey": "outdoorRisk"
    },
    {
      "key": "old",
      "short": "10년 이상 제품",
      "label": "10년 이상 된 제품인가요?",
      "risk": "yes",
      "conditionText": "노후 부품은 세척 중 파손될 수 있어 파손 책임이 면제됩니다."
    },
    {
      "key": "smell",
      "short": "심한 냄새",
      "label": "곰팡이 냄새가 심한가요?",
      "risk": "yes",
      "optionKey": "antibac"
    },
    {
      "key": "parking",
      "short": "주차",
      "label": "작업 차량 주차가 가능한가요?",
      "risk": "no",
      "conditionText": "주차가 불가하면 주차비(실비)가 추가될 수 있습니다."
    }
  ],
  "photoSlots": [
    {
      "key": "front",
      "label": "실내기 앞"
    },
    {
      "key": "model",
      "label": "모델명 스티커"
    },
    {
      "key": "outdoor",
      "label": "실외기 위치"
    }
  ],
  "pricing": {
    "base": {
      "type": "itemized",
      "label": "에어컨 세척",
      "itemsField": "units",
      "priceKey": "items",
      "minPriceKey": "minPrice",
      "itemTypes": [
        {
          "key": "wall",
          "label": "벽걸이",
          "unit": "대"
        },
        {
          "key": "stand",
          "label": "스탠드",
          "unit": "대"
        },
        {
          "key": "twoInOne",
          "label": "2in1 (스탠드+벽걸이)",
          "unit": "세트"
        },
        {
          "key": "ceiling1",
          "label": "천장형 1way",
          "unit": "대"
        },
        {
          "key": "ceiling4",
          "label": "천장형 4way",
          "unit": "대"
        }
      ]
    },
    "surcharges": [
      {
        "key": "peak",
        "label": "성수기(6~8월)",
        "when": {
          "field": "$month",
          "in": [
            6,
            7,
            8
          ]
        }
      },
      {
        "key": "weekend",
        "label": "주말·공휴일",
        "when": {
          "any": [
            {
              "field": "$weekend",
              "equals": true
            },
            {
              "field": "$holiday",
              "equals": true
            }
          ]
        }
      }
    ],
    "options": [
      {
        "key": "fullWash",
        "label": "완전 분해 세척",
        "quantityField": "$itemsCount",
        "unit": "대",
        "when": {
          "field": "washLevel",
          "equals": "full"
        },
        "priceLabel": "완전 분해 (1대당 추가)"
      },
      {
        "key": "outdoor",
        "label": "실외기 세척",
        "customerSelectable": true
      },
      {
        "key": "antibac",
        "label": "항균 코팅",
        "customerSelectable": true
      },
      {
        "key": "outdoorRisk",
        "label": "실외기 위험 작업비"
      }
    ],
    "warnings": []
  },
  "defaults": {
    "minPrice": 80000,
    "items": {
      "wall": 80000,
      "stand": 120000,
      "twoInOne": 180000,
      "ceiling1": 110000,
      "ceiling4": 150000
    },
    "surcharges": {
      "peak": 10,
      "weekend": 10
    },
    "options": {
      "fullWash": 30000,
      "outdoor": 30000,
      "antibac": 20000,
      "outdoorRisk": 30000
    },
    "policy": {
      "validDays": 7,
      "depositPct": 10,
      "cancelPolicy": "작업 3일 전까지 취소 시 계약금 전액 환불, 2일 전~전날 50% 환불, 당일 취소 시 환불 불가."
    }
  },
  "bookingNotice": ["에어컨 주변 물건을 조금 치워주시면 빨리 끝나요.", "작업 중 물을 쓰니 가까운 수도·화장실 위치를 알려주세요.", "주차 가능 여부를 알려주세요."],
  "labor": {
    "perItem": {
      "wall": 1,
      "stand": 1.5,
      "twoInOne": 2.5,
      "ceiling1": 1.5,
      "ceiling4": 2
    },
    "adjust": [
      {
        "when": {
          "field": "washLevel",
          "equals": "full"
        },
        "pct": 40
      }
    ],
    "min": 1,
    "crew": {
      "min": 1,
      "max": 3,
      "maxHours": 8
    }
  },
  "included": [
    "실내기 분해·고압 세척·건조",
    "배수 확인",
    "작업 전후 사진"
  ],
  "excluded": [
    "실외기 세척 (요청 시 별도)",
    "가스 충전·수리",
    "배관 교체"
  ],
  "sample": {
    "customer": {
      "name": "테스트 고객",
      "phone": "010-0000-0000",
      "region": "부산 부산진구"
    },
    "answers": {
      "buildingType": "home",
      "timeSlot": "am",
      "units": [
        {
          "type": "wall",
          "count": 2
        },
        {
          "type": "stand",
          "count": 1
        }
      ],
      "washLevel": "normal",
      "extras": [],
      "memo": "테스트"
    },
    "checklist": {
      "height": "no",
      "outdoorRisk": "unknown",
      "old": "no",
      "smell": "yes",
      "parking": "yes"
    }
  }
}
