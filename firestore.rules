rules_version = '2';

// 원칙
// - 사장님: 자기 shop(shops/{내 uid}) 과 그 shop 의 requests·quotes 만 읽기/쓰기
// - 고객(로그인 없음): requests 생성, 견적서 단건 읽기(get), 예약 요청(상태 1칸만 변경)
// - 견적서 ID(20자 랜덤)는 추측이 불가능하므로 "링크를 받은 사람만 읽기"가 된다. 목록 조회(list)는 막는다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(shopId) { return signedIn() && request.auth.uid == shopId; }
    function shopPath(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function str(v, max) { return v is string && v.size() <= max; }

    // 운영자: admins/{uid} 문서가 있는 계정 (Firebase 콘솔에서만 만든다)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 요금제 (설계도 12장). 문서가 없거나 만료되면 무료. 숫자는 js/plan.js 와 같아야 한다
    function planPath(shopId) { return /databases/$(database)/documents/shops/$(shopId)/billing/plan; }
    function planIn(shopId, plans) {
      let p = get(planPath(shopId)).data;
      return exists(planPath(shopId)) && p.plan in plans
        && (!('until' in p) || p.until == null || p.until > request.time);
    }
    function isPaid(shopId) { return planIn(shopId, ['solo', 'team', 'company']); }
    function hasTeam(shopId) { return planIn(shopId, ['team', 'company']); }
    // 이번 달 'YYYYMM' (한국 시간 = UTC + 9시간)
    function thisMonth() {
      let k = request.time + duration.value(9, 'h');
      return string(k.year() * 100 + k.month());
    }
    function usagePath(shopId) { return /databases/$(database)/documents/shops/$(shopId)/usage/$(thisMonth()); }
    // 견적서를 처음 만들 때: 같은 배치에서 이번 달 발송 수를 정확히 +1, 무료면 5건까지
    function countedSend(shopId) {
      let u = usagePath(shopId);
      return ((!exists(u) && getAfter(u).data.sent == 1) || (exists(u) && getAfter(u).data.sent == get(u).data.sent + 1))
        && (isPaid(shopId) || getAfter(u).data.sent <= 5);
    }

    // 운영자 표시: 본인 것만 읽을 수 있다 (운영자 화면이 스스로 확인). 쓰기는 콘솔에서만
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 고객이 견적서에서 "예약 요청"을 누를 때: sent → booking_requested 만 허용
    function isCustomerBooking() {
      return resource.data.status == 'sent'
        && request.resource.data.status == 'booking_requested'
        && request.resource.data.bookingRequestedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookingRequestedAt']);
    }

    // 업종 템플릿: 누구나 읽기, 쓰기는 Firebase 콘솔(관리자)에서만
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // 업체 공개 정보 (shopId = 사장님 uid)
    match /shops/{shopId} {
      function validShop() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'templateId', 'name', 'ownerName', 'phone', 'bizNo', 'logoUrl', 'manduId', 'intro', 'serviceArea', 'createdAt', 'updatedAt'])
          && d.ownerUid == shopId
          && str(d.templateId, 60)
          && (!('name' in d) || str(d.name, 60))
          && (!('phone' in d) || str(d.phone, 30))
          && (!('logoUrl' in d) || str(d.logoUrl, 1000))
          && (!('intro' in d) || str(d.intro, 60))
          && (!('serviceArea' in d) || str(d.serviceArea, 60))
          && (!('manduId' in d) || (d.manduId is string && d.manduId.matches('^([a-z0-9_]{3,20})?$')));
      }
      allow get: if true;            // 고객 화면에 상호·연락처 표시
      allow list: if isAdmin();      // 운영자 화면의 업체 목록
      allow create, update: if isOwner(shopId) && validShop();
      allow delete: if false;

      // 단가표 등 비공개 설정 (경쟁업체가 링크로 단가를 볼 수 없게 분리)
      match /private/{docId} {
        allow read, write: if isOwner(shopId);
      }

      // 요금제: 사장님은 읽기만, 바꾸는 건 운영자 (설계도 12장 ①단계: 입금 확인 후 수동 활성화)
      match /billing/{docId} {
        function validPlan() {
          let d = request.resource.data;
          return docId == 'plan'
            && d.keys().hasOnly(['plan', 'until', 'note', 'updatedAt', 'updatedBy'])
            && d.plan in ['free', 'solo', 'team', 'company']
            && (!('until' in d) || d.until == null || d.until is timestamp)
            && (!('note' in d) || str(d.note, 200));
        }
        allow read: if isOwner(shopId) || isAdmin();
        allow create, update: if isAdmin() && validPlan();
        allow delete: if isAdmin();
      }

      // 이번 달 견적 발송 수: 사장님이 견적서를 처음 만들 때 +1 만 가능 (줄이거나 지난 달을 고칠 수 없음)
      match /usage/{month} {
        function validUsage() {
          return month == thisMonth() && request.resource.data.keys().hasOnly(['sent', 'updatedAt']);
        }
        allow read: if isOwner(shopId) || isAdmin();
        allow create: if isOwner(shopId) && validUsage() && request.resource.data.sent == 1;
        allow update: if isOwner(shopId) && validUsage() && request.resource.data.sent == resource.data.sent + 1;
        allow delete: if false;
      }

      // 일정 (설계도 10-1장 ②단계). 고객 이름·연락처가 들어 있어 사장님만. 직원 열람은 ③·④단계에서 따로 연다.
      match /jobs/{jobId} {
        function validJob() {
          let d = request.resource.data;
          return d.keys().hasOnly(['date', 'start', 'hours', 'crew', 'staffIds', 'title', 'place', 'customer', 'phone', 'memo',
                                   'source', 'status', 'requestId', 'createdAt', 'updatedAt'])
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.start is string && d.start.matches('^[0-2][0-9]:[0-5][0-9]$')
            && d.hours is number && d.hours > 0 && d.hours <= 24
            && d.crew is int && d.crew >= 1 && d.crew <= 30
            && d.staffIds is list && d.staffIds.size() <= 30
            && str(d.title, 60)
            && (!('place' in d) || str(d.place, 120))
            && (!('customer' in d) || str(d.customer, 30))
            && (!('phone' in d) || str(d.phone, 30))
            && (!('memo' in d) || str(d.memo, 300))
            && d.source in ['quote', 'phone', 'soomgo', 'referral', 'other']
            && d.status in ['scheduled', 'done', 'canceled'];
        }
        allow read, delete: if isOwner(shopId);
        allow create, update: if isOwner(shopId) && validJob() && hasTeam(shopId); // 팀·회사 요금제
      }

      // 직원 (설계도 10-1장). 사장님이 만들고 고친다.
      // 연결된 직원은 자기 문서만 읽고, 개인 휴무일(offDates)·프리랜서 가능일(availDates)만 고친다.
      // 연결: 초대 링크의 무작위 값(inviteToken)을 inviteProof 로 보내 맞을 때만 자기 uid 를 넣을 수 있다.
      match /staff/{staffId} {
        function dateList(v) { return v is list && v.size() <= 400; }
        function tokenList(v) { return v is list && v.size() <= 5; } // 알림 받을 기기 (③단계)
        function validStaff() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'phone', 'type', 'weeklyOff', 'offDates', 'availDates', 'active', 'memo',
                                   'inviteToken', 'inviteProof', 'uid', 'linkedAt', 'pushTokens', 'createdAt', 'updatedAt'])
            && str(d.name, 30) && d.name.size() > 0
            && (!('phone' in d) || str(d.phone, 30))
            && d.type in ['employee', 'freelancer']
            && (!('weeklyOff' in d) || (d.weeklyOff is list && d.weeklyOff.size() <= 7))
            && (!('offDates' in d) || dateList(d.offDates))
            && (!('availDates' in d) || dateList(d.availDates))
            && (!('active' in d) || d.active is bool)
            && (!('memo' in d) || str(d.memo, 200))
            && (!('pushTokens' in d) || tokenList(d.pushTokens))
            && str(d.inviteToken, 64) && d.inviteToken.size() >= 16;
        }
        function isSelf() { return signedIn() && resource.data.get('uid', null) == request.auth.uid; }
        function selfEdit() {
          let d = request.resource.data;
          return d.diff(resource.data).affectedKeys().hasOnly(['offDates', 'availDates', 'pushTokens', 'updatedAt'])
            && (!('pushTokens' in d) || tokenList(d.pushTokens))
            && (!('offDates' in d) || dateList(d.offDates))
            && (!('availDates' in d) || dateList(d.availDates));
        }
        function linking() {
          return signedIn()
            && resource.data.get('uid', null) == null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteProof == resource.data.inviteToken
            && request.resource.data.linkedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'inviteProof', 'linkedAt']);
        }
        allow read: if isOwner(shopId) || isSelf();
        // 등록·수정은 팀·회사 요금제. 직원 본인의 휴무일·알림 등록과 계정 연결은 요금제와 상관없이
        allow create: if isOwner(shopId) && validStaff() && hasTeam(shopId);
        allow update: if (isOwner(shopId) && validStaff() && hasTeam(shopId)) || (isSelf() && selfEdit()) || linking();
        allow delete: if isOwner(shopId);
      }
    }

    // 고객 견적 요청
    match /requests/{requestId} {
      function validNewRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['shopId', 'templateId', 'status', 'test', 'customer', 'answers', 'checklist', 'photos', 'quoteId', 'createdAt'])
          && d.keys().hasAll(['shopId', 'templateId', 'status', 'customer', 'answers', 'createdAt'])
          && d.shopId is string
          && exists(shopPath(d.shopId))
          && d.templateId == get(shopPath(d.shopId)).data.templateId
          && d.status == 'new'
          && (!('test' in d) || d.test is bool)
          && (!('quoteId' in d) || d.quoteId == null)
          && d.createdAt == request.time
          && d.customer.keys().hasOnly(['name', 'phone', 'region'])
          && str(d.customer.name, 30) && d.customer.name.size() > 0
          && str(d.customer.phone, 20) && d.customer.phone.size() > 0
          && str(d.customer.region, 40)
          && d.answers is map && d.answers.keys().size() <= 40
          && (!('checklist' in d) || (d.checklist is map && d.checklist.keys().size() <= 40))
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 10));
      }
      allow create: if validNewRequest();
      allow read, delete: if isOwner(resource.data.shopId);
      allow update: if (isOwner(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId)
        || isCustomerBooking();
    }

    // 견적서
    match /quotes/{quoteId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.shopId == request.auth.uid;
      // 처음 만들 때만 이번 달 발송 수에 들어간다 (재발송은 update). 테스트 견적은 세지 않음
      allow create: if isOwner(request.resource.data.shopId)
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.shopId == request.auth.uid
        && (request.resource.data.get('test', false) == true || countedSend(request.resource.data.shopId));
      allow update: if (isOwner(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId)
        || isCustomerBooking();
      allow delete: if isOwner(resource.data.shopId);
    }
  }
}
