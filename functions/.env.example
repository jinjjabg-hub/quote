# 복사해서 functions/.env 로 저장 (공개돼도 되는 값만. 시크릿키는 여기 넣지 말 것)
# .env 는 .gitignore 로 커밋되지 않는다. 이 예시 파일만 커밋한다.
PAYMENT_MODE=test
# 토스페이먼츠 개발자센터 > API 키 > "테스트" 클라이언트 키 (test_ck_… 또는 결제위젯 test_gck_…)
TOSS_CLIENT_KEY=test_ck_REPLACE_ME
ALLOWED_ORIGINS=http://localhost:8080,https://YOUR_ID.github.io
# 이용약관·개인정보 처리방침 주소 (js/config.js paymentConfig.termsUrl/privacyUrl 과 같은 값)
# 둘 중 하나라도 비어 있으면 서버가 결제를 열지 않는다 (고객이 못 본 약관에 동의하는 것 방지)
TERMS_URL=
PRIVACY_URL=
# 시크릿(여기 말고 Secret Manager): TOSS_SECRET_KEY, NTS_SERVICE_KEY
#   npx firebase-tools functions:secrets:set NTS_SERVICE_KEY   ← 키 발급 전에는 none 입력(테스트 모드에서 체크섬만)
